package views

import (
	"sinais/components"
	"sinais/layout"
	"sinais/lib"
)

templ AlphabetPage() {
	@layout.Layout("Sinais - Alfabeto") {
		@components.Header("Alfabeto", "/", "Home")
		@AlphabetDivision("Símbolos", components.SinaisArr([]string{"@"}))
		@AlphabetDivision("Números", components.SinaisRange(lib.NumbersRangeStart, lib.NumbersRangeFinish))
		@AlphabetDivision("Letras", components.SinaisRange(lib.LettersRangeStart, lib.LettersRangeFinish))
	}
}

templ AlphabetDivision(title string, sinais templ.Component) {
	<div class="my-8">
		<h2 class="text-2xl">{ title }</h2>
		@sinais
	</div>
}
