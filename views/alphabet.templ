package views

import (
	"sinais/components"
	"sinais/layout"
	"sinais/lib"
)

templ AlphabetPage() {
	@layout.Layout("Sinais - Alfabeto") {
		@components.Header("Alfabeto", "/", "Home")
		<div class="my-8">
			<h2 class="text-4xl">Símbolos</h2>
			@components.SinaisArr(lib.GetSymbolsArr("Sinais"))
		</div>
		<div class="my-8">
			<h2 class="text-4xl">Números</h2>
			@components.SinaisRange(lib.NumbersRangeStart, lib.NumbersRangeFinish)
		</div>
		<div class="my-8">
			<h2 class="text-4xl">Letras</h2>
			@components.SinaisRange(lib.LettersRangeStart, lib.LettersRangeFinish)
		</div>
	}
}
