package components

templ AlphabetPage() {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link href="../static/css/output.css" rel="stylesheet"/>
			<script src="https://unpkg.com"></script>
		</head>
		<body>
			<!-- link para a home -->
			@Link("/", "Home")
			<!-- sinais -->
			@Sinal("a")
		</body>
	</html>
}
