package views

import (
	"sinais/components"
	"sinais/layout"
	"sinais/lib"
)

templ HomePage() {
	@layout.Layout("Sinais") {
		@components.Header("Frase Aleatória", "/alphabet", "Alfabeto")
		@components.Card() {
			@components.Phrase(lib.GetRandomPhrase(), templ.Attributes{"id": "phrase"})
			@components.CardFooter() {
				@components.Button("Outra Frase", templ.Attributes{"hx-get": "/getRandomPhrase", "hx-target": "#phrase", "hx-swap": "textContent"})
			}
		}
	}
}
