package layout

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="pt-BR" id="html" data-theme="sinais">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link href="/assets/static/css/output.css" rel="stylesheet"/>
			<link rel="icon" type="image/png" href="/assets/static/favicon.jpg"/>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js" integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" crossorigin="anonymous"></script>
			<script src="/assets/static/js/theme.js" defer></script>
			<title>{ title }</title>
		</head>
		<body class="container mx-auto bg-background text-accent py-8">
			{ children... }
		</body>
	</html>
}
